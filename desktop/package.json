{
  "name": "infinitum-killa-desktop",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "INFINITUM Killa AI local Windows with Supabase owner-scoped realtime and remote MCP",
  "main": "main.mjs",
  "scripts": {
    "dist:win": "node generate-windows-icon.mjs && electron-builder --win nsis --x64 --publish never",
    "pack:win": "node generate-windows-icon.mjs && electron-builder --win dir --x64 --publish never",
    "dist:release": "node generate-windows-icon.mjs && electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "br.com.w1capital.infinitum.killa",
    "productName": "INFINITUM Killa AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "runtime-policy.mjs",
      "public-origin.mjs",
      "package.json",
      "launcher-policy.mjs",
      "lifecycle-policy.mjs",
      "launcher-preload.cjs",
      "launcher.html",
      "launcher.css",
      "launcher-ui.js",
      "store-preload.cjs",
      "store-ui.js",
      "store.css",
      "store.html",
      "branding/**/*",
      "generate-windows-icon.mjs",
      "release-trust.mjs",
      "free-update-client.mjs"
    ],
    "extraResources": [
      {
        "from": "app-server",
        "to": "app-server",
        "filter": [
          "**/*",
          "!node_modules/**",
          "!**/.env",
          "!**/.env.*",
          "!**/*.pem",
          "!**/service-role*"
        ]
      },
      {
        "from": "app-server/node_modules",
        "to": "app-server/node_modules",
        "filter": [
          "**/*",
          "!**/.env",
          "!**/.env.*",
          "!**/*.pem",
          "!**/service-role*"
        ]
      },
      {
        "from": "signed-updates.json",
        "to": "signed-updates.json"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "INFINITUM-KillaAI-Setup-${version}-${arch}.exe",
      "verifyUpdateCodeSignature": true,
      "icon": "branding/infinitum-app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "author": "W1 Capital"
}
